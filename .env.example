# Executify — sample environment file.
# Copy to .env (`cp .env.example .env`) and fill in real secrets before running
# anything outside dev. Loaded automatically by the Makefile.

# ---- HTTP server ----------------------------------------------------------
SERVER_PORT=8080

# ---- Worker pool sizes ----------------------------------------------------
# One isolate box per goroutine; keep <= #CPU cores to avoid sandbox thrash.
SUBMIT_WORKER_COUNT=2
RUN_WORKER_COUNT=2

# ---- MySQL ----------------------------------------------------------------
# Defaults match docker-compose.yml; override if you point at an external DB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=executify
MYSQL_PASSWORD=executify257
MYSQL_DATABASE=executify
# DSN tail; parseTime is required for time.Time mapping. loc=Local keeps
# timestamps in the host's TZ.
MYSQL_OPTIONS=?parseTime=true&loc=Local

# ---- Redis ----------------------------------------------------------------
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SUBMIT_QUEUE=executify:queue:submit
REDIS_RUN_QUEUE=executify:queue:run

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
# NEVER ship the placeholder — the codebase falls back to a known string when
# unset, which is forge-any-token in production.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900       # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800   # 7 days

# ---- Code runner ----------------------------------------------------------
# Per-deployment secret used to hash sandbox file names. Generate with:
#   openssl rand -hex 32
# Empty value collapses the hash and lets attackers predict box paths.
FILE_SECRET=

# Modulus for deriving the isolate box ID from submission_id.
# Default 65535 is fine for low volume; bump or replace with a pool when you
# expect more than ~50k concurrent submissions over the box-id lifetime.
BOX_MODULUS=65535